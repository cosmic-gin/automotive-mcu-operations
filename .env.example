MCU_BACKEND=duckdb
MCU_DATA_DIR=data
# For PostgreSQL, choose a local password and set MCU_BACKEND=postgresql.
POSTGRES_USER=mcu
POSTGRES_DB=mcu
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
# Optional SQLAlchemy URL override (postgresql+psycopg://...).
MCU_POSTGRES_URL=
# Fictional operational targets (percent or units).
MCU_OTD_TARGET=95
MCU_YIELD_TARGET=97
MCU_BACKLOG_GROWTH_TARGET=20
MCU_INVENTORY_FLOOR=1000
MCU_DQ_MAX=0.5
